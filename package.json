{
  "name": "sqlite-viewer-studio",
  "displayName": "SQLite Viewer & Database Studio",
  "description": "Ultra-fast SQLite database viewer & studio. Instant pagination on 7GB+ databases, interactive ER diagrams, visual query charts, virtualized DataGrid, and SQL Studio.",
  "version": "1.2.0",
  "publisher": "ehsanshahbazi",
  "author": {
    "name": "Ehsan Shahbazi",
    "url": "https://github.com/EhsanShahbazii"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EhsanShahbazii/Shahbaz-Viewer.git"
  },
  "bugs": {
    "url": "https://github.com/EhsanShahbazii/Shahbaz-Viewer/issues"
  },
  "homepage": "https://github.com/EhsanShahbazii/Shahbaz-Viewer#readme",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Data Science",
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "sqlite",
    "sqlite3",
    "sqlite viewer",
    "database viewer",
    "sqlite studio",
    "sql viewer",
    "database",
    "data-grid",
    "er-diagram",
    "table-viewer",
    "db-viewer",
    "sql",
    "studio",
    "cursor"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.js",
  "activationEvents": [
    "onView:sqliteViewerStudio.databasesView",
    "onView:shahbazViewer.databasesView",
    "onCustomEditor:sqliteViewerStudio.editor",
    "onCustomEditor:shahbazViewer.editor",
    "onCommand:sqliteViewerStudio.openDatabase",
    "onCommand:sqliteViewerStudio.refreshDatabases"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sqliteViewerStudio",
          "title": "SQLite Studio",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "sqliteViewerStudio": [
        {
          "id": "sqliteViewerStudio.databasesView",
          "name": "SQLite Databases"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sqliteViewerStudio.databasesView",
        "contents": "No SQLite databases found in workspace.\n[Open Database File](command:sqliteViewerStudio.openDatabase)"
      }
    ],
    "customEditors": [
      {
        "viewType": "sqliteViewerStudio.editor",
        "displayName": "SQLite Viewer & Studio",
        "selector": [
          { "filenamePattern": "*.db" },
          { "filenamePattern": "*.sqlite" },
          { "filenamePattern": "*.sqlite3" },
          { "filenamePattern": "*.db3" },
          { "filenamePattern": "*.s3db" },
          { "filenamePattern": "*.sl3" }
        ],
        "priority": "default"
      },
      {
        "viewType": "shahbazViewer.editor",
        "displayName": "SQLite Viewer & Studio (Legacy Alias)",
        "selector": [
          { "filenamePattern": "*.db" },
          { "filenamePattern": "*.sqlite" },
          { "filenamePattern": "*.sqlite3" },
          { "filenamePattern": "*.db3" },
          { "filenamePattern": "*.s3db" },
          { "filenamePattern": "*.sl3" }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "sqliteViewerStudio.openDatabase",
        "title": "SQLite Studio: Open Database",
        "category": "SQLite Studio",
        "icon": "$(database)"
      },
      {
        "command": "sqliteViewerStudio.refreshDatabases",
        "title": "Refresh Databases",
        "category": "SQLite Studio",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "SQLite Viewer & Studio",
      "properties": {
        "sqliteViewerStudio.sqlite3Path": {
          "type": "string",
          "default": "",
          "description": "Custom path to the sqlite3 command line executable. Leave empty to automatically discover sqlite3 from system PATH and default directories."
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "sqliteViewerStudio.openDatabase",
          "when": "resourceExt == .db || resourceExt == .sqlite || resourceExt == .sqlite3 || resourceExt == .db3 || resourceExt == .s3db || resourceExt == .sl3",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "sqliteViewerStudio.openDatabase",
          "when": "view == sqliteViewerStudio.databasesView",
          "group": "navigation"
        },
        {
          "command": "sqliteViewerStudio.refreshDatabases",
          "when": "view == sqliteViewerStudio.databasesView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./ && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:extension": "node esbuild.js --watch",
    "watch:webview": "vite build --watch",
    "build:extension": "node esbuild.js --production",
    "build:webview": "vite build",
    "build": "npm run build:extension && npm run build:webview"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "^1.85.0",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.20.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "@vitejs/plugin-react": "^4.2.1"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.16.0",
    "@tanstack/react-virtual": "^3.5.0",
    "@vscode/codicons": "^0.0.36",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.10.3"
  }
}
