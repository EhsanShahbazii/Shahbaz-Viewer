{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rootDir": "./",
    "outDir": "out"
  },
  "include": ["src/**/*", "webview/**/*"],
  "exclude": ["node_modules", ".vscode-test", "dist"]
}
